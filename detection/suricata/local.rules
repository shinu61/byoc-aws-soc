alert tcp any any -> $HOME_NET any (msg:"CUSTOM Portscan Detected (SYN flood to many ports)"; flags:S; flow:to_server; threshold:type both, track by_src, count 20, seconds 60; classtype:attempted-recon; sid:1000001; rev:1;)

alert tcp any any -> $HOME_NET any (msg:"CUSTOM Possible TCP SYN Flood - 500 SYN packets in 10 seconds per source"; flags:S; flow:to_server; threshold:type both, track by_src, count 500, seconds 10; classtype:attempted-dos; priority:1; sid:1000002; rev:1;)
alert http any any -> any any (msg:"CUSTOM [R2] SQLi Success - MySQL Error Disclosure in HTTP Response"; flow:established,to_client; file_data; content:"You have an error in your SQL syntax"; nocase; classtype:web-application-attack; priority:1; sid:1000003; rev:1;)
alert http any any -> any any (msg:"CUSTOM [R2] SQLi Data Exfiltration - credential-like data in HTTP response"; flow:established,to_client; file_data; pcre:"/\b[a-f0-9]{32}\b.{0,3000}?\b[a-f0-9]{32}\b/is"; classtype:web-application-attack; priority:1; sid:1000004; rev:1;)
